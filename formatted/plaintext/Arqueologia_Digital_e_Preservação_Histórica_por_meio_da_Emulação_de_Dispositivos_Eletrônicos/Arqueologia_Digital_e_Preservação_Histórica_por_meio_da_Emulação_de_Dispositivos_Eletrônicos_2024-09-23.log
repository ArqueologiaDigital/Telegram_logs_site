[2024-09-23 00:51:45] RicBit: import sys

bitmap = []
for line in sys.stdin:
  a= [("0"*8 + bin(int(x,16))[2:])[-8:] for x in line.split()[1:17]]
  b="".join(a)
  bitmap.extend(b)
print("P1")
x = int(sys.argv[1])
print("%d %d" % (len(bitmap)//x,x))
for i in range(len(bitmap)//x):
  print(" ".join(str(i) for i in bitmap[i*x:i*x+x]))
