[2020-10-21 11:39:29] Felipe "Juca" Sanches [forwarded]:   .cr z8
  .tf z8dump.bin
  .org 0x9ee ; this is at CAC irq routine
; note: program assumes MSC/CAC init stuff is done (eg. port write direction)
; all jumps are relative, so this piece can be placed anywhere else

  di
  ld r4,#0
  ld r5,#0
  ld r6,#8
  ld r7,#0
  ld 3,#0

; lazy start signal: write port 3hi: 0x80, 0x00, 0x40, 0x00, 0x20, 0x00, 0x10, 0x00
  ld 3,#$80
  ld 3,#0
  ld 3,#$40
  ld 3,#0
  ld 3,#$20
  ld 3,#0
  ld 3,#$10
  ld 3,#0

LOOP
  ld r8,#$10
WAIT1
  djnz r8,WAIT1

  ldc r8,@rr4
  ld 2,r8

; strobe port 3 bit7, indicate byte available at port 2
  ld 3,#$80
  ld r8,#$10
WAIT2
  djnz r8,WAIT2
  ld 3,#0

  incw rr4
  decw rr6
  jr nz,LOOP

STOP
  jr STOP
[2020-10-21 11:39:30] Felipe "Juca" Sanches [forwarded]: Esse código foi colocado numa ROM externa para se fazer o dump da ROM interna de um MCU Zilog Z8 usado nesse jogo de xadrez:

https://github.com/mamedev/mame/blob/master/src/mame/drivers/fidel_msc.cpp
